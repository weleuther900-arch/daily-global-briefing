# 所有值仅为配置示例，不得在此文件写入真实密钥。
# 当前默认链路使用 DeepSeek：Flash 成稿，Pro 复核。
BRIEFING_GENERATOR_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-v4-flash
BRIEFING_REVIEWER_PROVIDER=deepseek
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
MONTHLY_AI_BUDGET_CNY=10
DAILY_AI_TOKEN_BUDGET=150000
# 用官方常规价格的两倍预留预算，覆盖已公布的峰时加价风险。
BUDGET_COST_SAFETY_MULTIPLIER=2
USD_CNY_RATE=7.2

# 首次部署时保持 false；完成一次人工版式测试后再改为 true。
ENABLE_EMAIL_SEND=false

# 只通过本机受保护环境或云端密钥管理器注入，不写入仓库。
DEEPSEEK_API_KEY=
X_BEARER_TOKEN=
GMAIL_APP_PASSWORD=
BRIEFING_SENDER_ADDRESS=
BRIEFING_RECIPIENT_ADDRESS=
